{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServicesSettings": {
    "ApolicesUri": ""
  },
  "HttpResilience": {
    "Timeout": "00:00:02",
    "ConcurrencyLimiter": {
      "PermitLimit": 50,
      "QueueLimit": 10
    },
    "Retry": {
      "MaxRetryAttempts": 1,
      "BaseDelay": "00:00:00.500"
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": "00:00:10",
      "MinimumThroughput": 4,
      "BreakDuration": "00:00:15"
    }
  }
}
