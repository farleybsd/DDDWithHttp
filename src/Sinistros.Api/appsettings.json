{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApolicesApi": {
    "BaseUrl": "http://localhost:5201",
    "Timeout": "00:00:02",
    "Retry": {
      "MaxRetryAttempts": 3,
      "BaseDelay": "00:00:00.500"
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": "00:00:10",
      "MinimumThroughput": 4,
      "BreakDuration": "00:00:15"
    }
  }
}
